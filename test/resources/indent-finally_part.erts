Name: package_body

=-=
package body Test is
   package body ABC is
   begin
      null;
   finally
      null;
   end ABC;

   package body ABC is
   begin
      null;
   exception
      when others =>
         null;
   finally
      null;
   end ABC;
begin
   null;
finally
   null;
end Test;
