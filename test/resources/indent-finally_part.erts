Name: extended_return_statement

=-=
function Test return Integer is
begin
   return X : Integer do
      null;
   finally
      null;
   end return;

   return X : Integer do
      null;
   exception
      when others =>
         null;
   finally
      null;
   end return;
end Test;
=-=-=

Name: Custom "label" offset

Code:
  (lambda ()
    (indent-transform
     (lambda ()
     (setq-local ada-ts-mode-indent-label-offset 8))))

=-=
package body Test is
begin
   BLOCK_LABEL: begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end;

   BLOCK_LABEL:
           begin
              X := X + 1;
           exception
              when others =>
                 null;
           finally
              null;
           end;

   BLOCK_LABEL: declare
      X : Integer := 0;
   begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end BLOCK_LABEL;

   BLOCK_LABEL:
           declare
              X : Integer := 0;
           begin
              X := X + 1;
           exception
              when others =>
                 null;
           finally
              null;
           end BLOCK_LABEL;
end Test;
=-=-=
