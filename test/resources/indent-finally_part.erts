Name: accept_statement

=-=
package body Test is
   task body Task_Body is
   begin
      accept Operation (X : Integer) do
         null;
      finally
         null;
      end Operation;

      accept Operation (X : Integer) do
         null;
      exception
         when others =>
            null;
      finally
         null;
      end Operation;
   end Task_Body;
end Test;
=-=-=

Name: block_statement

=-=
package body Test is
begin
   begin
      X := X + 1;
   finally
      null;
   end;

   begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end;

   BLOCK_LABEL: begin
      X := X + 1;
   finally
      null;
   end BLOCK_LABEL;

   BLOCK_LABEL: begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end BLOCK_LABEL;

   BLOCK_LABEL:
      begin
         X := X + 1;
      finally
         null;
      end BLOCK_LABEL;

   BLOCK_LABEL:
      begin
         X := X + 1;
      exception
         when others =>
            null;
      finally
         null;
      end BLOCK_LABEL;
end Test;
=-=-=

Name: declare block_statement

=-=
package body Test is
begin
   declare
      X : Integer := 0;
   begin
      X := X + 1;
   finally
      null;
   end;

   declare
      X : Integer := 0;
   begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end;

   BLOCK_LABEL: declare
      X : Integer := 0;
   begin
      X := X + 1;
   finally
      null;
   end BLOCK_LABEL;

   BLOCK_LABEL: declare
      X : Integer := 0;
   begin
      X := X + 1;
   exception
      when others =>
         null;
   finally
      null;
   end BLOCK_LABEL;

   BLOCK_LABEL:
      declare
         X : Integer := 0;
      begin
         X := X + 1;
      finally
         null;
      end BLOCK_LABEL;

   BLOCK_LABEL:
      declare
         X : Integer := 0;
      begin
         X := X + 1;
      exception
         when others =>
            null;
      finally
         null;
      end BLOCK_LABEL;
end Test;
