Name: entry_body

=-=
package body Test is
   protected body Protected_Body is
      entry Entry_Body when X > Y is
      begin
         null;
      finally
         null;
      end Entry_Body;

      entry Entry_Body when X > Y is
      begin
         null;
      exception
         when others =>
            null;
      finally
         null;
      end Entry_Body;
   end Protected_Body;
end Test;
